          "activity_id": 1402
        }
      ]
    },
    {
      "objective_id": 5,
      "segments": [
        {
          "id": 1501,
          "kind": "worked_example",
          "title": "Placeholder: Tracing BFS, again",
          "body": "Placeholder worked example.\n\nAt each step: take the vertex at the **front** of the queue, add it to the order, then add each unvisited neighbour, in alphabetical order, to the **back** of the queue and mark it visited."
        },
        {
          "id": 1502,
          "kind": "activity",
          "title": "Placeholder: practice on objective 5",
          "activity_id": 1501
        },
        {
          "id": 1503,
          "kind": "activity",
          "title": "Placeholder: fresh item on objective 5",
          "activity_id": 1502
        }
      ]
    },
    {
      "objective_id": 6,
      "segments": [
        {
          "id": 1601,
          "kind": "worked_example",
          "title": "Placeholder: Writing BFS, again",
          "body": "Placeholder worked example.\n\nThe queue must be first in, first out: `popleft()` takes the oldest vertex. Mark a neighbour visited when you **add** it to the queue, so it is never added twice."
        },
        {
          "id": 1602,
          "kind": "activity",
          "title": "Placeholder: practice on objective 6",
          "activity_id": 1601
        },
        {
