    },
    {
      "objective_id": 4,
      "segments": [
        {
          "id": 1401,
          "kind": "worked_example",
          "title": "Placeholder: Why BFS, again",
          "body": "Placeholder worked example.\n\nBFS visits vertices in order of how many edges away they are. Use it when you need everything reachable, or the fewest hops from a start."
        },
        {
          "id": 1402,
          "kind": "activity",
          "title": "Placeholder: practice on objective 4",
          "activity_id": 1401
        },
        {
          "id": 1403,
